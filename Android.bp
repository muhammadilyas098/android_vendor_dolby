android_app_import {
    name: "MotoDolbyDax3",
    owner: "moto",
    apk: "apps/MotoDolbyDax3.apk",
    privileged: true,
    certificate: "PRESIGNED",
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
}

android_app_import {
    name: "daxService",
    owner: "moto",
    apk: "apps/daxService.apk",
    privileged: true,
    certificate: "PRESIGNED",
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
}

python_binary_host {
    name: "dolby_patch_audio_effects",
    main: "tools/patch_audio_effects.py",
    srcs: ["tools/patch_audio_effects.py"],
    version: {
        py3: {
            embedded_launcher: true,
        },
    },
}
