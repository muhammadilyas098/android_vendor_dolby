// Dolby Atmos (DAX3) - blob dari Moto G52 (rhode) via modul Magisk
// Dikelola manual: tidak digenerate oleh extract-files.

soong_namespace {
    imports: [
        "vendor/moto/dolby",
    ],
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "moto",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "proprietary/vendor/lib/libdapparamstorage.so",
            ],
            shared_libs: [
                "libcutils",
                "libutils",
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libdapparamstorage.so",
            ],
            shared_libs: [
                "libcutils",
                "libutils",
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "both",
    prefer: true,
    soc_specific: true,
}

